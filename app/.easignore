# ==============================================================================
# EAS Build & Update Ignore File (.easignore)
# ==============================================================================

# Dependencies (Must NEVER be uploaded; EAS installs clean in the cloud)
node_modules
node_modules/
node_modules/**
**/node_modules/**
.pnpm-store
.yarn

# Git
.git
.git/
.git/**
**/.git/**

# Expo Cache & Build Outputs
.expo
.expo/
.expo/**
**/.expo/**
dist
dist/
dist/**
web-build
web-build/
*.tsbuildinfo

# Native Android Build Artifacts & Large Caches
android/.gradle
android/.gradle/**
android/build
android/build/**
android/app/build
android/app/build/**
android/.cxx
android/.cxx/**
android/app/.cxx
android/app/.cxx/**
android/captures
android/local.properties
local.properties
*.apk
*.aab

# Native iOS Build Artifacts & Pods
ios/Pods
ios/Pods/**
ios/build
ios/build/**
ios/DerivedData
ios/DerivedData/**

# IDE, Editor & AI Files
.idea
.idea/
.vscode
.vscode/
.claude
.claude/
AGENTS.md
CLAUDE.md
README.md
LICENSE

# Local Automation & Utility Scripts
build_apk.bat
scripts
scripts/
scripts/**

# Logs, Temp Files & Exports
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.tmp
temp_export
temp_export/
temp_export/**
inst_user_settings.tmp
.DS_Store
Thumbs.db

# Environment Local Overrides
.env*.local
